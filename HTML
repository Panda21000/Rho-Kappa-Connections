<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>History Connections</title>
<meta name="description" content="Find four groups of four connected history terms. An independent history puzzle game.">
<style>
:root{--ink:#171717;--tile:#efefe6;--selected:#5a594e;--yellow:#f9df6d;--green:#a0c35a;--blue:#b0c4ef;--purple:#ba81c5}
*{box-sizing:border-box}body{margin:0;background:#fff;color:var(--ink);font-family:Arial,Helvetica,sans-serif}header{border-bottom:1px solid #ddd;padding:22px 28px}header .inner{max-width:940px;margin:auto;display:flex;align-items:center;justify-content:space-between;gap:14px}h1{font:700 clamp(26px,4vw,38px)/1.1 Georgia,serif;margin:0}button,select{font:inherit;color:inherit}button{cursor:pointer;border:1px solid #171717;background:white;border-radius:28px;padding:13px 23px;font-size:16px;font-weight:600}button:disabled{cursor:default;color:#929292;border-color:#bbb}button:focus-visible,select:focus-visible{outline:3px solid #3264c6;outline-offset:3px}main{max-width:680px;margin:30px auto;padding:0 16px}.intro{text-align:center;font-size:18px;margin:0 0 22px}.picker{display:flex;align-items:center;justify-content:space-between;margin:0 0 16px;gap:12px;font-size:14px}.picker select{max-width:80%;border:0;background:white;font-weight:600;font-size:16px;padding:8px 0;cursor:pointer}.message{min-height:35px;text-align:center;font-size:16px;font-weight:600;line-height:1.5;margin-bottom:6px}.board{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.tile{border:0;border-radius:6px;background:var(--tile);height:88px;padding:8px 4px;display:flex;align-items:center;justify-content:center;font-size:17px;font-weight:750;line-height:1.15;overflow-wrap:anywhere;transition:background .12s,transform .12s}.tile:hover{background:#e3e3d7}.tile.selected{background:var(--selected);color:white}.tile:disabled{color:var(--ink)}.solved{grid-column:1/-1;min-height:88px;border-radius:6px;padding:16px 12px;display:flex;flex-direction:column;justify-content:center;text-align:center;gap:7px;animation:reveal .25s ease}.solved strong{font-size:17px}.solved span{font-size:16px;line-height:1.3}.c0{background:var(--yellow)}.c1{background:var(--green)}.c2{background:var(--blue)}.c3{background:var(--purple)}.mistakes{display:flex;justify-content:center;align-items:center;gap:13px;font-size:16px;margin:24px 0}.dots{display:flex;gap:10px}.dot{height:15px;width:15px;border-radius:50%;background:var(--selected)}.dot.used{background:#ddd}.actions{display:flex;justify-content:center;gap:10px;flex-wrap:wrap}.primary{background:#171717;color:white}.primary:disabled{background:white}.secondary{display:flex;justify-content:space-between;align-items:center;margin:24px 0}.secondary button{font-size:14px;border-color:#ddd;padding:10px 18px}.result{margin:22px 0 0;text-align:center}.result h2{font:700 27px Georgia,serif;margin:12px}.result p{font-size:16px;line-height:1.5}.history{font-size:25px;line-height:1.2;letter-spacing:2px}.footer{text-align:center;border-top:1px solid #eee;padding:22px 12px;margin-top:32px;font-size:13px;color:#666;line-height:1.5}dialog{border:1px solid #ddd;border-radius:10px;max-width:490px;width:calc(100% - 32px);padding:28px;color:var(--ink)}dialog::backdrop{background:#0007}dialog h2{font:700 30px Georgia,serif;margin:0 0 16px}dialog p,dialog li{font-size:16px;line-height:1.5}dialog ul{padding-left:22px}.legend{display:flex;gap:6px;margin:20px 0}.legend span{height:20px;flex:1;border-radius:4px}.shake{animation:shake .3s ease}
@keyframes shake{25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}
@keyframes reveal{from{opacity:.5;transform:scale(.97)}to{opacity:1;transform:scale(1)}}
@media(max-width:480px){header{padding:18px 16px}header button{padding:10px 14px;font-size:14px}main{margin-top:24px;padding:0 12px}.tile{height:80px;font-size:clamp(12px,3.5vw,16px)}.solved{min-height:80px}.solved strong{font-size:15px}.solved span{font-size:14px}.actions button{padding:12px 18px;font-size:14px}.board{gap:6px}.intro{font-size:16px}.picker select{font-size:14px}.picker{font-size:13px}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}

.unlock-note{text-align:center;font-size:14px;line-height:1.5;margin:-12px 0 20px;color:#735e4d}.level:disabled{color:#998b76;border-color:transparent;cursor:not-allowed}.level:disabled:hover{background:transparent}
/* Archive-room theme: parchment, dark ink, burgundy, and typeset rules. */
:root{--ink:#30251e;--tile:#e9dec7;--selected:#64312f}
body{background:#f6efdf;color:var(--ink);background-image:linear-gradient(90deg,transparent calc(100% - 1px),#5a352408 calc(100% - 1px));background-size:80px 100%}
header{border-top:6px solid #64312f;border-bottom:4px double #a78c68;background:#efe4ce}
header .inner{max-width:900px}.edition{font:16px/1.4 Georgia,serif;margin:9px 0 0;color:#695444}
h1{letter-spacing:-.8px}button{border-color:#7c6450;background:#f9f3e6;color:var(--ink)}
main{margin-top:28px}.intro{font:20px/1.4 Georgia,serif}
.picker{padding:14px 0;border-top:1px solid #bca782;border-bottom:1px solid #bca782}
.levels{display:flex;gap:6px}.level{padding:10px 18px;border-radius:4px;font-size:15px;background:transparent;border-color:transparent}
.level.active{background:#64312f;color:#fff8e9;border-color:#64312f}.level:hover:not(.active){background:#e9dec7}
.tile{border:1px solid #d1bea0;border-radius:4px;box-shadow:0 2px 0 #baa38525;font-family:Georgia,'Times New Roman',serif;font-weight:700}
.tile:hover{background:#dfcfb1}.tile.selected{background:var(--selected);border-color:var(--selected);color:#fff8e9}
.primary{background:#64312f;color:#fff8e9;border-color:#64312f}.primary:disabled{background:#f9f3e6}
.solved{border:1px solid #7d613033;border-radius:4px}.solved strong{letter-spacing:.3px}
.secondary button{border-color:#bca782}.footer{border-top:4px double #bca782;color:#735e4d}dialog{background:#f9f3e6;border:1px solid #a78c68}
.dot.used{background:#d8cbb5}.message{color:#64312f}
[hidden]{display:none!important}
@media(max-width:480px){header .inner{align-items:center}h1{font-size:27px}.edition{font-size:14px}.picker{gap:6px}.level{font-size:14px;padding:10px 12px}#progress{font-size:12px;white-space:nowrap}.intro{font-size:18px}.tile{font-size:clamp(12px,3.4vw,16px)}header button{padding:9px 10px;white-space:nowrap}}
</style>
</head>
<body>
<header>
  <div class="inner">
    <div>
      <h1>History Connections</h1>
      <p class="edition">Rho Kappa · October 7, 2026</p>
    </div>
    <button id="help">How to play</button>
  </div>
</header>
<main>
<p class="intro">Create four groups of four!</p>
<p class="unlock-note">Solve Easy to unlock Medium, then Medium to unlock Hard.</p>
<div class="picker">
  <div id="levels" class="levels" role="group" aria-label="Choose difficulty"></div>
  <span id="progress">0 / 4 groups</span>
</div>
<div id="message" class="message" role="status" aria-live="polite"></div>
<div id="board" class="board" aria-label="History puzzle board"></div>
<div class="mistakes">
  <span>Mistakes remaining:</span>
  <span id="dots" class="dots" aria-label="4 mistakes remaining"></span>
</div>
<div class="actions">
  <button id="shuffle">Shuffle</button>
  <button id="deselect">Deselect all</button>
  <button id="submit" class="primary" disabled>Submit</button>
</div>
<section id="result" class="result" hidden></section>
<div class="secondary">
  <button id="restart">Restart puzzle</button>
  <button id="next">Next puzzle</button>
</div>
<footer class="footer">
  Three puzzles for this meeting: Easy, Medium, and Hard.<br>
  Not affiliated with The New York Times.
</footer>
</main>

<dialog id="rules">
<h2>How to play</h2>
<p>This meeting has three puzzles: Easy, Medium, and Hard. Solve all four groups in Easy to unlock Medium, then solve Medium to unlock Hard. Revealed answers after a loss do not unlock the next level. Once unlocked, a level stays available. Find groups of four terms that share a connection.</p>
<ul>
  <li>Select four tiles, then press Submit.</li>
  <li>A correct group moves to the top of the board and reveals its category.</li>
  <li>An incorrect guess uses one mistake. You have four mistakes.</li>
  <li>“One away” means three of your four tiles belong to the same group.</li>
  <li>Each puzzle has one intended solution. Some terms may seem to fit more than one category.</li>
</ul>
<p>Groups range from straightforward to tricky:</p>
<div class="legend" aria-label="Yellow, green, blue, purple in increasing difficulty">
  <span class="c0"></span><span class="c1"></span>
  <span class="c2"></span><span class="c3"></span>
</div>
<p>Shuffle rearranges the tiles. Deselect all clears your selection. Enter submits a selected group.</p>
<button id="closeRules" class="primary">Got it</button>
</dialog>

<dialog id="resetDialog">
<h2>Restart this puzzle?</h2>
<p>Your guesses and solved groups for this puzzle will be cleared.</p>
<button id="cancelReset">Keep playing</button>
<button id="confirmReset" class="primary">Restart</button>
</dialog>

<script>
const EDITION = 'rho-kappa-2026-10-07';

const PUZZLES = [
  {
    level: 'Easy',
    groups: [
      {
        name: 'FIRST FOUR U.S. PRESIDENTS',
        words: ['WASHINGTON', 'ADAMS', 'JEFFERSON', 'MADISON']
      },
      {
        name: 'RENAISSANCE ARTISTS',
        words: ['LEONARDO', 'MICHELANGELO', 'RAPHAEL', 'DONATELLO']
      },
      {
        name: 'WORLD WAR II ALLIED LEADERS',
        words: ['ROOSEVELT', 'CHURCHILL', 'STALIN', 'CHIANG']
      },
      {
        name: 'U.S. HUMAN SPACEFLIGHT PROGRAMS',
        words: ['MERCURY', 'GEMINI', 'APOLLO', 'ARTEMIS']
      }
    ]
  },
  {
    level: 'Medium',
    groups: [
      {
        name: 'ANCIENT GREEK CITY-STATES',
        words: ['ATHENS', 'SPARTA', 'CORINTH', 'THEBES']
      },
      {
        name: 'ENLIGHTENMENT THINKERS',
        words: ['LOCKE', 'ROUSSEAU', 'VOLTAIRE', 'MONTESQUIEU']
      },
      {
        name: 'AGE OF EXPLORATION NAVIGATORS',
        words: ['COLUMBUS', 'MAGELLAN', 'DA GAMA', 'CABRAL']
      },
      {
        name: '___ EMPIRE',
        words: ['HOLY ROMAN', 'OTTOMAN', 'BRITISH', 'MONGOL']
      }
    ]
  },
  {
    level: 'Hard',
    groups: [
      {
        name: 'TREATY OF ___',
        words: ['PARIS', 'VERSAILLES', 'GHENT', 'TORDESILLAS']
      },
      {
        name: 'ENGLISH ROYAL HOUSES',
        words: ['YORK', 'LANCASTER', 'TUDOR', 'STUART']
      },
      {
        name: 'AMERICAN CIVIL WAR GENERALS',
        words: ['GRANT', 'LEE', 'SHERMAN', 'JACKSON']
      },
      {
        name: '___ REVOLUTION',
        words: ['GLORIOUS', 'INDUSTRIAL', 'CULTURAL', 'FRENCH']
      }
    ]
  }
];

const $ = id => document.getElementById(id);
const colors = ['🟨', '🟩', '🟦', '🟪'];
let index = 0;
let state;
const completed = new Set();

try {
  const saved = JSON.parse(
    localStorage.getItem('history-connections-' + EDITION + '-completed') || '[]'
  );

  if (Array.isArray(saved)) {
    saved.forEach(i => {
      if (Number.isInteger(i) && i >= 0 && i < PUZZLES.length) {
        completed.add(i);
      }
    });
  }

  PUZZLES.forEach((_, i) => {
    const previous = JSON.parse(
      localStorage.getItem('history-connections-' + EDITION + '-' + i) || 'null'
    );
    if (previous?.solved?.length === 4) completed.add(i);
  });
} catch (e) {}

function isUnlocked(i) {
  return Number.isInteger(i) &&
    i >= 0 &&
    i < PUZZLES.length &&
    Array.from({ length: i }, (_, n) => n).every(n => completed.has(n));
}

function updateLocks() {
  document.querySelectorAll('.level').forEach((button, n) => {
    const unlocked = isUnlocked(n);
    button.disabled = !unlocked;
    button.classList.toggle('active', n === index);
    button.setAttribute('aria-pressed', String(n === index));
    button.setAttribute(
      'aria-label',
      PUZZLES[n].level +
        (unlocked ? '' : ' — locked; solve ' + PUZZLES[n - 1].level + ' first')
    );
    button.title = unlocked
      ? ''
      : 'Solve ' + PUZZLES[n - 1].level + ' to unlock';
  });

  $('next').disabled = !isUnlocked(index + 1);
  $('next').title =
    $('next').disabled && index < PUZZLES.length - 1
      ? 'Solve this level to continue'
      : '';
}

function mix(list) {
  const a = [...list];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

function fresh() {
  return {
    order: mix(PUZZLES[index].groups.flatMap(g => g.words)),
    selected: [],
    solved: [],
    mistakes: 0,
    guesses: [],
    seen: [],
    over: false
  };
}

function save() {
  if (state.solved.length === 4) completed.add(index);

  try {
    localStorage.setItem(
      'history-connections-' + EDITION + '-completed',
      JSON.stringify([...completed])
    );
    localStorage.setItem(
      'history-connections-' + EDITION + '-' + index,
      JSON.stringify(state)
    );
  } catch (e) {}
}

function load(i) {
  if (!isUnlocked(i)) return;
  index = i;

  let saved;
  try {
    saved = JSON.parse(
      localStorage.getItem('history-connections-' + EDITION + '-' + i)
    );
  } catch (e) {}

  state = saved &&
    Array.isArray(saved.order) &&
    Array.isArray(saved.solved) &&
    Array.isArray(saved.selected) &&
    Array.isArray(saved.guesses) &&
    Array.isArray(saved.seen) &&
    typeof saved.mistakes === 'number'
      ? saved
      : fresh();

  updateLocks();
  $('message').textContent = '';
  render();
}

function render() {
  updateLocks();

  const board = $('board');
  board.replaceChildren();

  $('next').hidden = index === PUZZLES.length - 1;
  $('next').textContent = index < PUZZLES.length - 1
    ? 'Next: ' + PUZZLES[index + 1].level
    : 'Next level';

  const addGroup = (n, revealed = false) => {
    const g = PUZZLES[index].groups[n];
    const row = document.createElement('div');
    row.className = 'solved c' + n;

    const title = document.createElement('strong');
    title.textContent = g.name + (revealed ? ' · REVEALED' : '');

    const terms = document.createElement('span');
    terms.textContent = g.words.join(', ');

    row.append(title, terms);
    board.append(row);
  };

  state.solved.forEach(n => addGroup(n));

  if (state.over) {
    PUZZLES[index].groups.forEach((g, n) => {
      if (!state.solved.includes(n)) addGroup(n, true);
    });
  } else {
    state.order.forEach(word => {
      const btn = document.createElement('button');
      btn.className = 'tile' +
        (state.selected.includes(word) ? ' selected' : '');
      btn.textContent = word;
      btn.setAttribute(
        'aria-pressed',
        String(state.selected.includes(word))
      );

      btn.onclick = () => {
        if (state.selected.includes(word)) {
          state.selected = state.selected.filter(w => w !== word);
        } else if (state.selected.length < 4) {
          state.selected.push(word);
        } else {
          say('You can only select four tiles.');
          return;
        }
        save();
        render();
      };

      board.append(btn);
    });
  }

  $('progress').textContent = state.solved.length + ' / 4 groups';
  $('dots').replaceChildren();

  for (let i = 0; i < 4; i++) {
    const dot = document.createElement('span');
    dot.className = 'dot' +
      (i >= 4 - state.mistakes ? ' used' : '');
    $('dots').append(dot);
  }

  $('dots').setAttribute(
    'aria-label',
    (4 - state.mistakes) + ' mistakes remaining'
  );

  $('submit').disabled = state.over || state.selected.length !== 4;
  $('deselect').disabled = state.over || !state.selected.length;
  $('shuffle').disabled = state.over;

  $('result').hidden = !state.over;
  $('result').replaceChildren();

  if (state.over) {
    const h = document.createElement('h2');
    h.textContent = state.solved.length === 4
      ? 'You found all four!'
      : 'Next time, history is yours.';

    const p = document.createElement('p');
    p.textContent = state.solved.length === 4
      ? [
          'Perfect puzzle!',
          'Great work!',
          'Nicely done.',
          'You made the connections!'
        ][state.mistakes]
      : state.solved.length +
        ' of 4 groups found. The remaining answers are revealed above.';

    const log = document.createElement('div');
    log.className = 'history';
    log.textContent = state.guesses
      .map(row => row.map(n => colors[n]).join(''))
      .join('\n');
    log.style.whiteSpace = 'pre-line';

    const share = document.createElement('button');
    share.textContent = 'Share results';
    share.onclick = shareResults;

    $('result').append(h, p, log, share);
  }
}

function say(text) {
  $('message').textContent = text;
}

function submit() {
  if (state.over || state.selected.length !== 4) return;

  const key = [...state.selected].sort().join('|');

  if (state.seen.includes(key)) {
    say('Already guessed!');
    return;
  }

  state.seen.push(key);
  const groups = PUZZLES[index].groups;

  state.guesses.push(
    state.selected.map(w => groups.findIndex(g => g.words.includes(w)))
  );

  const match = groups.findIndex(
    g => state.selected.every(w => g.words.includes(w))
  );

  if (match >= 0) {
    state.solved.push(match);
    state.order = state.order.filter(w => !state.selected.includes(w));
    state.selected = [];
    say('Correct!');
    if (state.solved.length === 4) state.over = true;
  } else {
    state.mistakes++;

    const close = groups.some(
      (g, n) =>
        !state.solved.includes(n) &&
        state.selected.filter(w => g.words.includes(w)).length === 3
    );

    say(close ? 'One away...' : 'Not quite. Try again!');

    if (state.mistakes === 4) {
      state.over = true;
      state.selected = [];
    } else {
      const board = $('board');
      board.classList.remove('shake');
      void board.offsetWidth;
      board.classList.add('shake');
    }
  }

  save();
  render();
}

async function shareResults() {
  const text =
    'History Connections · ' +
    PUZZLES[index].level +
    ' · October 7, 2026\n' +
    state.guesses
      .map(row => row.map(n => colors[n]).join(''))
      .join('\n');

  try {
    await navigator.clipboard.writeText(text);
    say('Results copied!');
  } catch (e) {
    const p = document.createElement('textarea');
    p.value = text;
    p.setAttribute('aria-label', 'Results to copy');
    p.style.width = '100%';
    $('result').append(p);
    p.focus();
    p.select();
    say('Select and copy your results below.');
  }
}

PUZZLES.forEach((p, i) => {
  const button = document.createElement('button');
  button.className = 'level';
  button.textContent = p.level;
  button.setAttribute('aria-pressed', 'false');
  button.onclick = () => load(i);
  $('levels').append(button);
});

$('shuffle').onclick = () => {
  state.order = mix(state.order);
  save();
  render();
};

$('deselect').onclick = () => {
  state.selected = [];
  save();
  render();
};

$('submit').onclick = submit;

$('next').onclick = () => {
  if (index < PUZZLES.length - 1) load(index + 1);
};

$('restart').onclick = () => $('resetDialog').showModal();
$('cancelReset').onclick = () => $('resetDialog').close();

$('confirmReset').onclick = () => {
  state = fresh();
  save();
  say('');
  render();
  $('resetDialog').close();
};

$('help').onclick = () => $('rules').showModal();
$('closeRules').onclick = () => $('rules').close();

document.addEventListener('keydown', e => {
  if (
    e.key === 'Enter' &&
    !document.querySelector('dialog[open]') &&
    document.activeElement === document.body
  ) {
    submit();
  }
});

load(0);
</script>
</body>
</html>
